python_sources = [
    '__init__.py',
    'aberration.py',
    'analysis.py',
    'array_ops.py',
    'bunch.py',
    'cgrid.py',
    'colorize.py',
    'colors.py',
    'coordinates.py',
    'curvedsky.py',
    'enmap.py',
    'enplot.py',
    'fft.py',
    'interpol.py',
    'lensing.py',
    'memory.py',
    'mpi.py',
    'mpiutils.py',
    'multimap.py',
    'pointsrcs.py',
    'powspec.py',
    'reproject.py',
    'resample.py',
    'tilemap.py',
    'uharm.py',
    'utils.py',
    'wavelets.py',
    'wcsutils.py',
    'bench.py',
    'device.py',
    'config.py',
    'coordsys.py',
    'ephem.py',
    'sites.py',
    'warray.py',
    'sqlite.py',
