py.install_sources(
    python_sources,
    subdir: 'pixell'
)

# Fonts used for plotting, with the licenses they are distributed under
py.install_sources(
    [
        'fonts/Roboto-Regular.ttf',
        'fonts/DejaVuSerif.ttf',
        'fonts/LICENSE_ROBOTO',
        'fonts/LICENSE_DEJAVU',
    ],
    subdir: 'pixell/fonts'
)
